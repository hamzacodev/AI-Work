# Model layer (same code for Ollama and Groq)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_MAIN=llama3.1:8b
LLM_MODEL_FAST=llama3.1:8b
LLM_MODEL_FALLBACK=llama3.1:8b
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=120

# Local use runs on Ollama (free, no limits) and never touches Groq. A deployed server switches to Groq BY ITSELF:
# set APP_ENV=production there, plus GROQ_API_KEY. Nothing else changes.
APP_ENV=local
GROQ_API_KEY=
# GROQ_MODEL_MAIN=llama-3.3-70b-versatile
# GROQ_MODEL_FAST=llama-3.1-8b-instant

# "web" searches the web for the market price (uses Tavily credits). "fixed" uses a demo price and spends nothing, good for playing around.
RESEARCH_MODE=web

# Research
TAVILY_API_KEY=
TAVILY_MONTHLY_CAP=800
RESEARCH_CACHE_HOURS=24

# Database (Supabase, server side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safety and cost control
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
DAILY_LLM_CALL_BUDGET=600
MAX_LLM_CALLS_PER_DEAL=300
MAX_VENDORS_PER_DEAL=10
MAX_ROUNDS=10
CEILING_RATIO=0.95
RATE_LIMIT_PER_MINUTE=30
CLIENT_IP_HEADER=cf-connecting-ip
AGENT_ENABLED=false   # true on a server that should run the agent (start negotiations, resume after restarts)
ALLOW_RESET=false     # TESTING ONLY: true lets the website wipe every deal and chat (POST /admin/reset)
REAL_SEND_ENABLED=false
OWNER_TEST_ALLOWLIST=
# Read only by the evaluation runner, ignored by the API
SAFETY_ENABLED=true

# OpenRouter (saved for later, not used by the app yet)
OPENROUTER_API_KEY=

# Groq (saved for Phase 7, not enabled yet)
GROQ_API_KEY=
